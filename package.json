{
  "name": "unemployed-wizard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for a free food / free stuff events app",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "npm run build:frontend && (tsc -p tsconfig.frontend.json --watch --preserveWatchOutput & node --watch src/index.ts)",
    "start": "npm run build:frontend && node src/index.ts",
    "build": "tsc && npm run build:frontend",
    "build:frontend": "tsc -p tsconfig.frontend.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.frontend.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "leaflet": "^1.9.4",
    "leaflet-rotate": "0.5.3",
    "multer": "^2.0.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^1.4.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
